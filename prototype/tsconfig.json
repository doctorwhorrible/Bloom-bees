{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "types": ["vite/client", "node"],
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["src", "tools"]
}
